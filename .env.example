# Standalone is the backward-compatible local default.
PLATFORM_AUTH_ENABLED=false
AUTHFORTRESS_URL=
AUTHFORTRESS_TIMEOUT_SECONDS=5
REDIS_KEY_PREFIX=pipewatch
# Exact numeric scheme://host:port origins for controlled local callback tests only.
CALLBACK_TRUSTED_ORIGINS=
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# CLI identity comes from the shell environment, not command arguments.
PIPEWATCH_TOKEN=
PIPEWATCH_TENANT_ID=
